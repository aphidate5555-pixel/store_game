# Supabase (public — the anon key is safe to publish)
NEXT_PUBLIC_SUPABASE_URL=https://vwoxglwkjzktuekjnfsj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_GX7hOH6n1eioFPNKKXT5rw_J9pODsNS

# Public URL of the site (canonical / OG / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# E2E only — a Supabase project you control, used exclusively by CI (C-44).
# The hosted project above is for manual QA and must never be used by CI.
# ---------------------------------------------------------------------------
# How E2E seeds its admin user (F-16): the CI project owner runs
# `npm run e2e:seed` once per fresh CI database. The script uses the Supabase
# Management API with SUPABASE_ACCESS_TOKEN (a CI secret that never reaches
# the application bundle) to create the admin user, then applies
# supabase/seed.e2e.sql over the direct Postgres connection to grant the
# `admins` row. No service_role key is ever present in the repository or in
# the production application's environment.
SUPABASE_E2E_URL=
SUPABASE_E2E_ANON_KEY=

# CI-only. Never defined in the production Vercel project.
SUPABASE_ACCESS_TOKEN=
SUPABASE_CI_DB_URL=
